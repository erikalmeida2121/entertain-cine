rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /lists/{listId} {
      // quem tem o link (id da lista) consegue abrir a lista para entrar nela
      allow get: if request.auth != null;
      // cada pessoa só lista as listas em que já é membro
      allow list: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        (request.auth.uid in request.resource.data.members
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','names']))
      );
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
    }
  }
}
